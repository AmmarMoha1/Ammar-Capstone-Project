# Copy this file to .env and fill in the values.
# .env is ignored by Git — never commit real secrets.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# True for local development, False otherwise.
DJANGO_DEBUG=True

# Comma-separated host names the app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
