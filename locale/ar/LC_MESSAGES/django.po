msgstr[3] "مرتبة حسب توافق المجموعة للمسافرين من %(city)s، %(start)s – %(end)s (%(nights)s ليالٍ)."
msgstr[4] "مرتبة حسب توافق المجموعة للمسافرين من %(city)s، %(start)s – %(end)s (%(nights)s ليلة)."
msgstr[5] "مرتبة حسب توافق المجموعة للمسافرين من %(city)s، %(start)s – %(end)s (%(nights)s ليلة)."

