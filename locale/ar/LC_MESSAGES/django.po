msgstr "تعديل الرحلة"

msgid "New boarding pass"
msgstr "بطاقة صعود جديدة"

msgid "Changing the dates or departure city clears any recommendations, because costs, flights and weather change."
msgstr "تغيير التواريخ أو مدينة المغادرة يمسح التوصيات الحالية، لأن التكاليف والرحلات والطقس تتغير."

msgid "Create a trip"
msgstr "أنشئ رحلة"

msgid "You'll get an invite code to share with your friends."
msgstr "ستحصل على كود دعوة تشاركه مع أصحابك."

msgid "Save changes"
msgstr "حفظ التغييرات"

msgid "Create trip"
msgstr "إنشاء الرحلة"

msgid "Cancel"
msgstr "إلغاء"

msgid "Trip name"
msgstr "اسم الرحلة"

msgid "Departing from"
msgstr "المغادرة من"

msgid "Start date"
msgstr "تاريخ البداية"

msgid "End date"
msgstr "تاريخ النهاية"

msgid "For example: Winter Getaway."
msgstr "مثال: رحلة الشتاء."

