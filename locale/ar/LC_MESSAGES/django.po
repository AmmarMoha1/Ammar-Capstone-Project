msgid "%(hours)sh"
msgstr "%(hours)s س"

#, python-format
msgid "≈ %(cost)s SAR"
msgstr "≈ %(cost)s ريال"

msgid "Click the stack to shuffle"
msgstr "اضغط على البطاقات لتقليبها"

msgid "How it works"
msgstr "كيف تشتغل؟"

msgid "Tap to flip ↻"
msgstr "اضغط لقلب البطاقة ↻"

msgid "Pick your departure city and dates. You get an invite code to share."
msgstr "اختر مدينة المغادرة والتواريخ، وتحصل على كود دعوة تشاركه."

msgid "Everyone adds preferences"
msgstr "كل واحد يضيف تفضيلاته"

msgid "Each friend privately sets a budget, flight limits, weather and interests."
msgstr "كل صديق يحدد بسرية ميزانيته وحدود الطيران والطقس واهتماماته."

msgid "Decide together"
msgstr "قرّروا مع بعض"

msgid "See destinations ranked by Group Match, understand why, and lock in the choice."
msgstr "شوفوا الوجهات مرتبة حسب توافق المجموعة، وافهموا السبب، وثبّتوا الاختيار."

msgid "The fairness rule"
msgstr "قاعدة العدل"

msgid "One unhappy friend can't be averaged away."
msgstr "المتوسط ما يخفي صديقًا غير راضٍ."

msgid "Group Match blends the average with the lowest member's score, so a place everyone likes beats a place most people love."
msgstr "توافق المجموعة يجمع بين المتوسط وأقل درجة بين الأعضاء، فالمكان الذي يعجب الجميع يتفوق على مكان يحبه أغلبهم فقط."

msgid "Average"
msgstr "المتوسط"

msgid "Lowest member"
msgstr "أقل عضو"

msgid "Group Match"
msgstr "توافق المجموعة"

msgid "0.7 × average + 0.3 × lowest"
msgstr "0.7 × المتوسط + 0.3 × الأقل"

